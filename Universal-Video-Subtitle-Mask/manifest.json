{
  "manifest_version": 3,
  "name": "Universal Video Subtitle Mask",
  "version": "1.3",
  "description": "Smart draggable subtitle mask with color themes for Bilibili, YouTube, Netflix and more.",
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bilibili.com/*",
        "*://*.youtube.com/*",
        "*://*.netflix.com/*",
        "*://*.ted.com/*",
        "*://*.coursera.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}